# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-13
SANITY_API_TOKEN=your_write_token_optional

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
CONTACT_EMAIL=hello@aayushhandicrafts.com
CONTACT_EMAIL_FROM=noreply@aayushhandicrafts.com
ORDER_EMAIL_FROM=orders@aayushhandicrafts.com

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_ACCESS_SECRET=<64-char-random-hex>
JWT_REFRESH_SECRET=<64-char-random-hex>
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# OTP + WhatsApp (MSG91)
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=AAYUSH

# Admin
ADMIN_EMAIL=hello@aayushhandicrafts.com

# Cron (silver rate daily fetch)
CRON_SECRET=<random-secret>

# Instagram (optional)
INSTAGRAM_ACCESS_TOKEN=...
